# Public commercial site URL, resolved at build time. Does not change DNS or the ERP.
# Keep the existing domain until the commercial domain is approved and configured.
NEXT_PUBLIC_SITE_URL=https://lugaerp.com.br

# EmailJS: required for demonstration requests (no built-in database or CRM).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# International phone number, digits only. Empty values use the existing public contact.
NEXT_PUBLIC_WHATSAPP_NUMBER=5521996452396
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá, quero conhecer o Luga ERP.
